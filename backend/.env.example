# PostgreSQL Connection String
# Example: postgresql://username:password@localhost:5432/mamar_bari_pos
DATABASE_URL=postgresql://username:password@localhost:5432/mamar_bari_pos

# Server Port
PORT=5000

# Secret used to sign staff logins and customer table sessions.
# REQUIRED in production -- the server refuses to boot without it.
JWT_SECRET=change_me_to_a_long_random_string

# Web terminal in the Admin view. Leave unset in normal operation: it runs
# arbitrary shell commands on the server, guarded only by a 4-digit staff PIN.
# Set to true only for a short debugging session, then unset it again.
# ENABLE_ADMIN_TERMINAL=true

# Public address of the customer-facing frontend. This is what gets baked into
# every printed table QR code, so it MUST be the real public URL -- a wrong
# value here means reprinting every sticker in the restaurant.
# Production: https://mamar-bari-pos.vercel.app
# Local dev:  http://localhost:5173
FRONTEND_URL=https://mamar-bari-pos.vercel.app
